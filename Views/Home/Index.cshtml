@{
    ViewData["Title"] = "Home Page";
}

<div class="hero text-center py-5">
    <h1 class="display-4 fw-bold mb-3">Insider Careers</h1>
    <p class="mb-2">Already have an account? <a asp-controller="Account" asp-action="Login">Login</a></p>

    <form asp-controller="Account" asp-action="Login" method="post" class="d-flex flex-column align-items-center gap-2 mx-auto" style="max-width: 400px;">
        <input type="text" name="Email" placeholder="Username"
               class="form-control" style="border-radius: 20px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: white;" />
        <input type="password" name="Password" placeholder="Password"
               class="form-control" style="border-radius: 20px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: white;" />
        <button type="submit" class="btn btn-primary" style="border-radius: 20px; width: 100%; height: 44px;">Login</button>
    </form>
    <div class="d-flex justify-content-center gap-3 mx-auto mt-4" style="max-width: 700px;">
        <div class="panel flex-fill">
            <h3 class="fw-bold">Job Seekers</h3>
            <a asp-controller="Account" asp-action="RegisterJobseeker" class="btn btn-outline-primary">Get Started</a>
        </div>
        <div class="panel flex-fill">
            <h3 class="fw-bold">Employers</h3>
            <a asp-controller="Account" asp-action="RegisterEmployer" class="btn btn-outline-primary">Get Started</a>
        </div>
    </div>
</div>
        <div class="bento-verified">
            <div class="panel h-100 h-100 text-center">
                <h3 class="fw-bold">Verified &amp; Trusted</h3>
                <p>Every employer is verified before their postings go live, so you can apply with confidence.</p>
            </div>
        </div>
    </div>
</div>
