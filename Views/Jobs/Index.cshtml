@model List<InsiderCareers.Models.Job>
@{ ViewData["Title"] = "Jobs"; }

<div class="container py-5">
    <h2 class="fw-bold mb-4">Open Jobs</h2>
    @if (!Model.Any())
    {
        <p>No jobs posted yet.</p>
    }
    else
    {
        @foreach (var job in Model)
        {
            <div class="mb-3 p-3 border rounded">
                <h5><a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none">@job.Title</a></h5>
                <p>@job.Employer?.CompanyName · @job.Location · @job.JobType</p>
                <p>
    @job.Employer?.CompanyName
    @if (job.Employer?.InterviewStatus == true)
    {
        <span class="badge" style="background:#1e3a8a;">✔ Verified</span>
    }
    · @job.Location · @job.JobType
</p>
            </div>
        }
    }
</div>