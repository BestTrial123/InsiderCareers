@{
    var userType = Context.Session.GetString("UserType");
    var userName = Context.Session.GetString("UserName") ?? userType;
}

@if (userType == "JobSeeker")
{
    <!-- JobSeeker Sidebar -->
    <div class="jsd-sidebar">
            <div class="pt-2 text-center mb-2">
        <img src="~/Images/logo.png" style="height: 80px;" />
    </div>
        <div class="jsd-top-icons">
            <a href="javascript:void(0)" onclick="history.back()" title="Back"><i class="bi bi-arrow-left"></i></a>
            <a asp-controller="Account" asp-action="Message" title="Messages"><i class="bi bi-envelope"></i></a>
            <a asp-controller="Account" asp-action="JobSeekerDashboard" title="Profile"><i class="bi bi-person-circle"></i></a>
        </div>

        <div class="jsd-photo"></div>

        <div class="jsd-mini-icons">
            <i class="bi bi-gear"></i>
            <i class="bi bi-eye"></i>
        </div>

        <div class="jsd-fullname">@userName</div>
        <div class="jsd-contact">
    @Context.Session.GetString("UserEmail")<br />
    @Context.Session.GetString("UserPhone")
</div>
        <div class="jsd-nav">
            <a asp-controller="Account" asp-action="JobSeekerDashboard" class="active">Home</a>
            <a asp-controller="Account" asp-action="Message">Message</a>
            <a asp-controller="Account" asp-action="Appointments">Appointments</a>
            <a asp-controller="Account" asp-action="Settings">Settings</a>
        </div>

        <div class="jsd-logout-wrap">
            <a asp-controller="Account" asp-action="Logout">Logout</a>
            <div class="jsd-footer">© 2026 Insider Careers</div>
        </div>
    </div>
}
else
{
    <!-- Employer / Admin Sidebar -->
    <div class="d-flex flex-column p-3" style="width: 240px; background: rgba(255,255,255,0.03); border-right: 1px solid rgba(255,255,255,0.1);">

        <div class="pt-2 text-center">
            <img src="~/Images/logo.png" style="height: 120px;" />
        </div>

        <div class="text-center mb-3">
            <div class="d-flex justify-content-between mb-4" style="margin-top: -1.5rem;">
                <span class="d-flex align-items-center">
                    <a href="javascript:void(0)" onclick="history.back()" class="text-white-50 me-2">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <span class="position-relative">
                        <i class="bi bi-envelope text-white-50"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary"></span>
                    </span>
                </span>
                <i class="bi bi-person-circle text-white-50"></i>
            </div>

            <div class="rounded-circle bg-secondary mx-auto mb-2" style="width: 64px; height: 64px;"></div>
            <div class="fw-bold">@Context.Session.GetString("UserContactName")</div>
            <small class="text-white-50">@userName</small>
            <small class="text-white-50 d-block">@Context.Session.GetString("UserEmail")</small>
        </div>

        <div class="d-flex justify-content-around text-center mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <div>
                <div><i class="bi bi-briefcase"></i></div>
                <small class="text-white-50">0</small>
            </div>
            <div>
                <div><i class="bi bi-send"></i></div>
                <small class="text-white-50">0</small>
            </div>
            <div>
                <div><i class="bi bi-eye"></i></div>
                <small class="text-white-50">0</small>
            </div>
        </div>

        @if (userType == "Employer")
        {
            <a asp-controller="Account" asp-action="EmployerDashboard" class="sidebar-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
            <a asp-controller="Account" asp-action="Candidates" class="sidebar-link"><i class="bi bi-people me-2"></i>Candidates</a>
        }
        else if (userType == "Admin")
        {
            <a asp-controller="Account" asp-action="AdminDashboard" class="sidebar-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
            <a asp-controller="Account" asp-action="VerifyEmployers" class="sidebar-link"><i class="bi bi-patch-check me-2"></i>vVerify Employers</a>
        }

        <a asp-controller="Account" asp-action="Message" class="sidebar-link"><i class="bi bi-chat-dots me-2"></i>Message</a>
        <a asp-controller="Account" asp-action="Calendar" class="sidebar-link"><i class="bi bi-calendar3 me-2"></i>Calendar</a>

        <div class="jsd-logout-wrap">
            <a asp-controller="Account" asp-action="Logout" class="sidebar-link"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
            <div class="jsd-footer">© 2026 Insider Careers</div>
        </div>
    </div>
}
