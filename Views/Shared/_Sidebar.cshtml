<!-- Sidebar -->
<div class="d-flex flex-column p-3" style="width: 240px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px;">

    <!-- Logo centered -->
    <div class="pt-2 text-center">
        <img src="~/Images/logo.png" style="height: 120px;" />
    </div>

    <div class="text-center mb-3">
        <div class="d-flex justify-content-between mb-4" style="margin-top: -1.5rem;">
    <span class="d-flex align-items-center">
        <a href="javascript:void(0)" onclick="history.back()" class="text-white-50 me-2">
            <i class="bi bi-arrow-left"></i>
        </a>
        <span class="position-relative">
            <i class="bi bi-envelope text-white-50"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary"></span>
        </span>
    </span>
    <i class="bi bi-person-circle text-white-50"></i>
</div>
        @{
    var userType = Context.Session.GetString("UserType");
    var userName = Context.Session.GetString("UserName") ?? userType;
}

<div class="fw-bold">@userName</div>
<small class="text-white-50">@userType</small>

    <div class="d-flex justify-content-around text-center mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <div>
            <div><i class="bi bi-briefcase"></i></div>
            <small class="text-white-50">0</small>
        </div>
        <div>
            <div><i class="bi bi-send"></i></div>
            <small class="text-white-50">0</small>
        </div>
        <div>
            <div><i class="bi bi-eye"></i></div>
            <small class="text-white-50">0</small>
        </div>
    </div>

    @if (userType == "Employer")
{
    <a asp-controller="Account" asp-action="EmployerDashboard" class="sidebar-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
    <a asp-controller="Account" asp-action="Candidates" class="sidebar-link"><i class="bi bi-people me-2"></i>Candidates</a>
}
else if (userType == "JobSeeker")
{
    <a asp-controller="Account" asp-action="JobSeekerDashboard" class="sidebar-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
    <a asp-controller="Jobs" asp-action="Index" class="sidebar-link"><i class="bi bi-search me-2"></i>Find Jobs</a>
}
else if (userType == "Admin")
{
    <a asp-controller="Account" asp-action="AdminDashboard" class="sidebar-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
}

<a asp-controller="Account" asp-action="Message" class="sidebar-link"><i class="bi bi-chat-dots me-2"></i>Message</a>
