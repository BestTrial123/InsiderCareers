@model List<InsiderCareers.Models.Employer>
@{
    ViewData["Title"] = "Verify Employers";
}

<div class="ps-0 pt-3">
    <h2>Verify Employers</h2>
    <p class="mb-0" style="color:#cbd5e1;">Review and approve employer accounts</p>
</div>

<div style="height: 40px;"></div>

<div class="card p-3">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Company</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Business Type</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                var isVerified = emp.GetType().GetProperty("IsVerified")?.GetValue(emp) as bool? ?? false;
                <tr>
                    <td>@emp.CompanyName</td>
                    <td>@emp.ContactName</td>
                    <td>@emp.Email</td>
                    <td>@emp.BusinessType</td>
                    <td>
                        @if (emp.InterviewStatus)
{
    <span class="badge" style="background:#14532d;">Verified</span>
}
else
{
    <span class="badge" style="background:#374151;">Pending</span>
}
                    </td>
                    <td>
                        <form asp-action="ToggleVerification" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@emp.Id" />
                            @if (isVerified)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Unverify</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Verify</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>