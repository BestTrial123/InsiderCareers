@model InsiderCareers.Models.JobSeekerDashboardViewModel
@{
    ViewData["Title"] = "Job Seeker Profile";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Job Seeker Profile - InsiderCareers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        html, body {
            margin: 0;
            min-height: 100vh;
        }

        .jsd-page {
            display: grid;
            grid-template-columns: 260px 1fr 240px;
            min-height: 100vh;
        }

        .jsd-sidebar {
            padding: 24px 20px;
            border-right: 1px solid rgba(255,255,255,0.1);
            display: flex;
            flex-direction: column;
        }

        .jsd-top-icons {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .jsd-top-icons a {
            color: #cfd3e0;
            text-decoration: none;
            font-size: 1.2rem;
        }

        .jsd-photo {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            background: rgba(255,255,255,0.1);
            display: block;
            margin: 0 auto 12px auto;
        }

        .jsd-mini-icons {
            display: flex;
            justify-content: space-between;
            padding: 0 8px;
            margin-bottom: 16px;
        }

        .jsd-mini-icons i {
            color: #cfd3e0;
            font-size: 1.1rem;
        }

        .jsd-fullname {
            font-weight: 700;
            font-size: 1.05rem;
        }

        .jsd-contact {
            color: #9aa0b4;
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .jsd-nav {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .jsd-nav a {
            padding: 10px 16px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            text-decoration: none;
            font-size: 0.9rem;
        }

        .jsd-nav a.active {
            background: #3b5bff;
            border-color: #3b5bff;
        }

        .jsd-logout-wrap {
            margin-top: auto;
        }

        .jsd-logout-wrap a {
            display: block;
            padding: 10px 16px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 16px;
        }

        .jsd-footer {
            color: #6b7086;
            font-size: 0.75rem;
        }

        .jsd-center {
            padding: 24px 28px;
        }

        .jsd-search {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .jsd-search input {
            flex: 1;
            padding: 12px 16px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.06);
            color: #fff;
        }

        .jsd-job-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 14px;
        }

        .jsd-job-top {
            display: flex;
            justify-content: space-between;
            color: #9aa0b4;
            font-size: 0.8rem;
            margin-bottom: 6px;
        }

        .jsd-job-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .jsd-job-info h4 {
            margin: 0 0 4px 0;
        }

        .jsd-job-info p {
            color: #9aa0b4;
            margin: 0;
            font-size: 0.9rem;
        }

        .jsd-job-right {
            text-align: right;
        }

        .jsd-apply-btn {
            background: #3b5bff;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 0.85rem;
            cursor: pointer;
            margin-bottom: 6px;
        }

        .jsd-salary {
            color: #cfd3e0;
            font-size: 0.85rem;
        }

        .jsd-right {
            padding: 24px 20px;
            border-left: 1px solid rgba(255,255,255,0.1);
        }

        .jsd-stat-circle {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            margin: 0 auto 6px auto;
        }

        .jsd-stat {
            text-align: center;
            margin-bottom: 22px;
        }

        .jsd-stat span.label {
            display: block;
            color: #9aa0b4;
            font-size: 0.8rem;
        }

        .jsd-appt-box {
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 10px;
        }

        .jsd-appt-box h4 {
            background: rgba(255,255,255,0.06);
            margin: 0;
            padding: 10px 12px;
            font-size: 0.9rem;
        }

        .jsd-cal-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .jsd-cal-date {
            background: #3b5bff;
            border-radius: 8px;
            width: 44px;
            height: 44px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .jsd-cal-date .day {
            font-weight: 700;
            font-size: 1rem;
            color: #fff;
            line-height: 1;
        }

        .jsd-cal-date .mon {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.8);
            letter-spacing: 0.05em;
        }

        .jsd-cal-info .company {
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .jsd-cal-info .role {
            color: #9aa0b4;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

<div class="jsd-page">

    <div class="jsd-sidebar">
        <div class="jsd-top-icons">
            <a href="javascript:void(0)" onclick="history.back()" title="Back"><i class="bi bi-arrow-left"></i></a>
            <a asp-controller="Account" asp-action="Message" title="Messages"><i class="bi bi-envelope"></i></a>
            <a asp-controller="Account" asp-action="JobSeekerDashboard" title="Profile"><i class="bi bi-person-circle"></i></a>
        </div>

        @if (!string.IsNullOrEmpty(Model.JobSeeker.PhotoPath))
        {
            <img src="@Model.JobSeeker.PhotoPath" class="jsd-photo" alt="Profile photo" />
        }
        else
        {
            <div class="jsd-photo"></div>
        }

        <div class="jsd-mini-icons">
            <i class="bi bi-briefcase"></i>
            <i class="bi bi-eye"></i>
        </div>

        <div class="jsd-fullname">@Model.JobSeeker.FirstName @Model.JobSeeker.LastName</div>
        <div class="jsd-contact">
            @Model.JobSeeker.Email<br />
            @Model.JobSeeker.Phone
        </div>

        <div class="jsd-nav">
            <a asp-controller="Account" asp-action="JobSeekerDashboard" class="active">Profile</a>
            <a href="#">Appointments</a>
            <a asp-controller="Account" asp-action="Message">Message</a>
            <a asp-controller="Account" asp-action="Settings">Settings</a>
        </div>

        <div class="jsd-logout-wrap">
            <a asp-controller="Account" asp-action="Logout">Logout</a>
            <div class="jsd-footer">© 2026 Insider Careers</div>
        </div>
    </div>

    <div class="jsd-center">
        <form class="jsd-search" method="get" asp-action="JobSeekerDashboard" asp-controller="Account">
            <input type="text" name="q" placeholder="Search job title or keyword" />
            <input type="text" name="location" placeholder="Country / City" />
        </form>

        @if (!Model.JobFeed.Any())
        {
            <p style="color:#9aa0b4;">No open jobs right now — check back soon.</p>
        }

        @foreach (var job in Model.JobFeed)
        {
                           var minutesAgo = (int)(DateTime.UtcNow - job.PostedDate).TotalMinutes;
                var daysAgo = minutesAgo / 1440;
                var postedText = daysAgo >= 1
                    ? $"Posted {daysAgo} day{(daysAgo == 1 ? "" : "s")} ago"
                    : $"Posted {minutesAgo} min ago";
                <div class="jsd-job-card">
                    <div class="jsd-job-top">
                        <span>@job.Employer?.CompanyName - @job.Location</span>
                        <span>@postedText</span>
                    </div>
                    <div class="jsd-job-main">
                        <div class="jsd-job-info">
                            <h4>@job.Title</h4>
                            <div class="jsd-salary">@job.Salary</div>
                        </div>
                        <div class="jsd-job-right">
                            <form asp-action="Apply" asp-controller="Jobs" method="post">
                                <input type="hidden" name="jobId" value="@job.Id" />
                                <button type="submit" class="jsd-apply-btn">Apply</button>
                            </form>
                        </div>
                    </div>
                </div>

        }
    </div>

    <div class="jsd-right">
        <div class="jsd-stat">
            <div class="jsd-stat-circle">@Model.AppliedCount</div>
            <span class="label">Applied</span>
        </div>
        <div class="jsd-stat">
            <div class="jsd-stat-circle">@Model.SavedCount</div>
            <span class="label">Saved</span>
        </div>
        <div class="jsd-stat">
            <div class="jsd-stat-circle">@Model.ViewedCount</div>
            <span class="label">Viewed</span>
        </div>

        <div class="jsd-appt-box">
            <h4>Interview Appointment</h4>
            @if (!Model.InterviewAppointments.Any())
            {
                <!-- Preview examples — remove once real interview data exists -->
                <div class="jsd-cal-row">
                    <div class="jsd-cal-date"><span class="day">25</span><span class="mon">AUG</span></div>
                    <div class="jsd-cal-info">
                        <div class="company">Diamond State</div>
                        <div class="role">Housekeeping — 10:00 AM</div>
                    </div>
                </div>
                <div class="jsd-cal-row">
                    <div class="jsd-cal-date"><span class="day">27</span><span class="mon">AUG</span></div>
                    <div class="jsd-cal-info">
                        <div class="company">Bright Harbor Co.</div>
                        <div class="role">Warehouse Associate — 2:30 PM</div>
                    </div>
                </div>
                <div class="jsd-cal-row">
                    <div class="jsd-cal-date"><span class="day">02</span><span class="mon">SEP</span></div>
                    <div class="jsd-cal-info">
                        <div class="company">Harborview Hotel</div>
                        <div class="role">Front Desk Clerk — 9:00 AM</div>
                    </div>
                </div>
            }
            else
            {
                foreach (var appt in Model.InterviewAppointments)
                {
                    <div class="jsd-cal-row">
                        <div class="jsd-cal-date">
                            <span class="day">@appt.InterviewDate?.ToString("dd")</span>
                            <span class="mon">@appt.InterviewDate?.ToString("MMM").ToUpper()</span>
                        </div>
                        <div class="jsd-cal-info">
                            <div class="company">@appt.Job?.Employer?.CompanyName</div>
                            <div class="role">@appt.Job?.Title — @appt.InterviewDate?.ToString("h:mm tt")</div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="jsd-stat" style="margin-top:22px;">
            <div class="jsd-stat-circle">@Model.DeniedCount</div>
            <span class="label">Applications Denied</span>
        </div>
    </div>

</div>

</body>
</html>
