@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="ps-0 pt-3">
    <h2>Admin Dashboard</h2>
    <p class="mb-0" style="color:#cbd5e1;">@ViewBag.AdminName</p>
    <p class="mb-0" style="color:#cbd5e1;">@ViewBag.AdminEmail</p>
</div>

<div style="height: 140px;"></div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 text-white" style="background:#0f2f4f;">
            <div class="small">Total Clicks</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalClicks</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-white" style="background:#14532d;">
            <div class="small">Total Earnings</div>
            <div class="fs-3 fw-bold">$@ViewBag.TotalEarnings</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-white" style="background:#374151;">
            <div class="small">Rate per Click</div>
            <div class="fs-3 fw-bold">$@ViewBag.RatePerClick</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-white" style="background:#1e3a8a;">
            <div class="small">Jobs Posted</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalJobs</div>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">Employer Verification</h5>
            <p class="mb-0 text-muted small">@ViewBag.PendingEmployers pending employer(s) awaiting review</p>
        </div>
        <a asp-controller="Account" asp-action="VerifyEmployers" class="btn btn-outline-primary">
            Verify Employers
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card p-3 h-100">
            <h5>Clicks per Job</h5>
            <canvas id="clicksChart" height="100"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card p-3 h-100">
            <h5>Recent Activity</h5>
            <ul class="list-unstyled mb-0">
                @foreach (dynamic job in ViewBag.RecentJobs)
                {
                    <li class="d-flex justify-content-between border-bottom py-2">
                        <span>
                            <strong>@job.Title</strong>
                            <br />
                            <small class="text-muted">@job.Employer?.CompanyName</small>
                        </span>
                        <span class="text-muted small align-self-center">New Job</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <h5>Recent Employer Signups</h5>
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Company</th>
                <th>Contact</th>
                <th>Business Type</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (dynamic emp in ViewBag.RecentEmployers)
            {
                <tr>
                    <td>@emp.CompanyName</td>
                    <td>@emp.ContactName</td>
                    <td>@emp.BusinessType</td>
                    <td>
                        @if (emp.InterviewStatus)
                        {
                            <span class="badge" style="background:#14532d;">Verified</span>
                        }
                        else
                        {
                            <span class="badge" style="background:#6b7280;">Pending</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">Logout</a>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('clicksChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.JobLabels)),
                datasets: [{
                    label: 'Clicks',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.JobClicks)),
                    backgroundColor: '#1e3a8a'
                }]
            }
        });
    </script>
}
    