@{
    ViewData["Title"] = "Admin Dashboard";

    string adminName = ViewBag.AdminName ?? "Admin";
    string initials = "AD";
    var parts = adminName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length >= 2) { initials = ("" + parts[0][0] + parts[1][0]).ToUpper(); }
    else if (parts.Length == 1 && parts[0].Length > 0) { initials = parts[0].Substring(0, System.Math.Min(2, parts[0].Length)).ToUpper(); }
}

<head>
<style>
  :root{
    --bg-0:#0a0c16;
    --bg-1:#0d1020;
    --surface:#141a30;
    --surface-2:#171d38;
    --border:#252c4a;
    --text-hi:#f2f3fb;
    --text-mid:#a7add0;
    --text-low:#6b7196;
    --violet:#7c5cff;
    --violet-2:#a78bfa;
    --teal:#22c39a;
    --amber:#f5a524;
    --blue:#3b82f6;
    --radius:16px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    background:
      radial-gradient(1100px 600px at 85% -10%, rgba(124,92,255,0.18), transparent 60%),
      radial-gradient(900px 500px at -10% 90%, rgba(34,195,154,0.10), transparent 55%),
      var(--bg-0);
    color:var(--text-hi);
    min-height:100vh;
    display:flex;
  }
  h1,h2,h3,.brand{font-family:'Space Grotesk',sans-serif;}

  /* Sidebar */
  .sidebar{
    width:76px;
    background:var(--bg-1);
    border-right:1px solid var(--border);
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:24px 0;
    gap:6px;
    flex-shrink:0;
  }
  .sidebar .logo{
    width:40px;height:40px;border-radius:12px;
    background:linear-gradient(135deg,var(--violet),#4f3bd6);
    display:flex;align-items:center;justify-content:center;
    font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;color:#fff;
    margin-bottom:32px;
  }
  .nav-item{
    width:44px;height:44px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    color:var(--text-low);
    cursor:pointer;
    transition:.15s;
  }
  .nav-item svg{width:20px;height:20px;}
  .nav-item:hover{background:var(--surface);color:var(--text-mid);}
  .nav-item.active{background:linear-gradient(135deg,var(--violet),#4f3bd6);color:#fff;}
  .nav-spacer{flex:1;}

  /* Main */
  .main{flex:1;padding:32px 40px 60px;max-width:1280px;}
  .topbar{
    display:flex;justify-content:space-between;align-items:flex-start;
    margin-bottom:28px;flex-wrap:wrap;gap:20px;
  }
  .greeting h1{font-size:30px;font-weight:600;letter-spacing:-0.02em;}
  .greeting .wave{display:inline-block;transform-origin:70% 70%;}
  .greeting p{color:var(--text-mid);font-size:14px;margin-top:6px;}
  .who{
    display:flex;align-items:center;gap:10px;margin-top:14px;
  }
  .avatar{
    width:36px;height:36px;border-radius:50%;
    background:linear-gradient(135deg,var(--violet-2),var(--violet));
    display:flex;align-items:center;justify-content:center;
    font-size:13px;font-weight:600;color:#fff;
  }
  .who .name{font-size:14px;font-weight:600;}
  .who .email{font-size:12px;color:var(--text-low);}
  .clock{text-align:right;}
  .clock .time{font-family:'Space Grotesk',sans-serif;font-size:38px;font-weight:600;letter-spacing:-0.02em;}
  .clock .time span{font-size:16px;color:var(--violet-2);margin-left:4px;font-weight:600;}
  .clock .date{color:var(--text-mid);font-size:13px;margin-top:2px;}

  /* Stat cards */
  .stat-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-bottom:22px;
  }
  .stat-card{
    border-radius:var(--radius);
    padding:20px 22px;
    display:flex;flex-direction:column;gap:14px;
    border:1px solid var(--border);
    position:relative;
    overflow:hidden;
  }
  .stat-card .icon-wrap{
    width:34px;height:34px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,0.12);
  }
  .stat-card .icon-wrap svg{width:18px;height:18px;}
  .stat-card .label{font-size:13px;opacity:.85;}
  .stat-card .value{font-family:'Space Grotesk',sans-serif;font-size:28px;font-weight:700;}
  .stat-card.clicks{background:linear-gradient(135deg,#1e3a8a,#1d2a63);color:#dbe6ff;}
  .stat-card.earnings{background:linear-gradient(135deg,#0f6e56,#0a4b3c);color:#d6f5ea;}
  .stat-card.rate{background:var(--surface);color:var(--text-hi);}
  .stat-card.jobs{background:linear-gradient(135deg,#312e81,#4338ca);color:#e4e2ff;}

  /* Content grid */
  .grid-2{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;margin-bottom:18px;}
  .panel{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:22px;
  }
  .panel h2{font-size:16px;font-weight:600;margin-bottom:4px;}
  .panel .sub{font-size:12.5px;color:var(--text-low);margin-bottom:16px;}

  .verify-row{display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .verify-row p{font-size:13px;color:var(--text-mid);max-width:220px;}
  .btn{
    border:none;border-radius:10px;padding:10px 16px;
    font-family:'Inter',sans-serif;font-size:13px;font-weight:600;
    cursor:pointer;transition:.15s;white-space:nowrap;
  }
  .btn-primary{background:linear-gradient(135deg,var(--violet),#4f3bd6);color:#fff;}
  .btn-primary:hover{filter:brightness(1.1);}
  .btn-outline{background:transparent;border:1px solid var(--border);color:var(--text-hi);}
  .btn-outline:hover{background:var(--surface-2);border-color:var(--violet-2);}
  .btn-row{display:flex;gap:10px;flex-wrap:wrap;}

  .manage-row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}

  .chart-wrap{position:relative;height:200px;margin-top:6px;}

  .activity-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--border);
  }
  .activity-item:last-child{border-bottom:none;padding-bottom:0;}
  .activity-item .title{font-size:14px;font-weight:600;}
  .activity-item .company{font-size:12.5px;color:var(--text-low);}
  .badge{
    font-size:11px;font-weight:600;padding:4px 10px;border-radius:999px;
    background:rgba(34,195,154,0.15);color:var(--teal);white-space:nowrap;
  }

  footer{margin-top:8px;text-align:center;color:var(--text-low);font-size:12px;padding:10px 0 0;}

  @@media (max-width:900px){
    .stat-grid{grid-template-columns:repeat(2,1fr);}
    .grid-2{grid-template-columns:1fr;}
    .sidebar{display:none;}
    .main{padding:24px 18px 40px;}
    .clock .time{font-size:30px;}
  }
</style>
</head>
<body>

  <aside class="sidebar">
    <div class="logo">IC</div>
    <div class="nav-item active" title="Dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
    </div>
    <div class="nav-item" title="Employers">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/></svg>
    </div>
    <div class="nav-item" title="Job Seekers">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/></svg>
    </div>
    <div class="nav-item" title="Jobs">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
    </div>
    <div class="nav-item" title="Analytics">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-item" title="Settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1-1.6 1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1 1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"/></svg>
    </div>
    <div class="nav-item" title="Log out">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div class="greeting">
        <h1 id="greetingText">Good morning, <span style="color:var(--violet-2)">Christopher</span> <span class="wave">👋</span></h1>
        <p>Admin dashboard · Insider Careers</p>
        <div class="who">
          <div class="avatar">CR</div>
          <div>
            <div class="name">Christopher G. Reeves</div>
            <div class="email">Cgeorgerev30@outlook.com</div>
          </div>
        </div>
      </div>
      <div class="clock">
        <div class="time" id="liveTime">--:-- <span id="ampm">--</span></div>
        <div class="date" id="liveDate">Loading date…</div>
      </div>
    </div>

    <section class="stat-grid">
      <div class="stat-card clicks">
        <div class="icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/></svg></div>
        <div><div class="label">Total clicks</div><div class="value">3</div></div>
      </div>
      <div class="stat-card earnings">
        <div class="icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5c0-1.4 1.3-2.5 3-2.5s3 1.1 3 2.5-1.3 2-3 2.5-3 1.1-3 2.5 1.3 2.5 3 2.5 3-1.1 3-2.5"/></svg></div>
        <div><div class="label">Total earnings</div><div class="value">$0.45</div></div>
      </div>
      <div class="stat-card rate">
        <div class="icon-wrap" style="background:rgba(124,92,255,0.18);"><svg viewBox="0 0 24 24" fill="none" stroke="var(--violet-2)" stroke-width="1.8"><path d="M4 12h16M4 6h16M4 18h10"/></svg></div>
        <div><div class="label" style="color:var(--text-mid)">Rate per click</div><div class="value">$0.15</div></div>
      </div>
      <div class="stat-card jobs">
        <div class="icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/></svg></div>
        <div><div class="label">Jobs posted</div><div class="value">2</div></div>
      </div>
    </section>

    <section class="grid-2">
      <div class="panel">
        <h2>Clicks per job</h2>
        <div class="sub">Click distribution across active postings</div>
        <div class="chart-wrap">
          <canvas id="clicksChart" role="img" aria-label="Bar chart showing clicks per job: Dave's Hot Chicken 2 clicks, Painter 1 click">Dave's Hot Chicken: 2 clicks. Painter: 1 click.</canvas>
        </div>
      </div>

      <div class="panel">
        <h2>Employer verification</h2>
        <div class="sub">Pending employer accounts awaiting review</div>
        <div class="verify-row">
          <p>0 pending employer(s) awaiting review</p>
          <button class="btn btn-outline" onclick="sendPromptSafe('Show me pending employer verifications')">Verify employers</button>
        </div>

        <div style="height:1px;background:var(--border);margin:20px 0;"></div>

        <h2>Manage users</h2>
        <div class="sub">Employers and job seekers on the platform</div>
        <div class="btn-row">
          <button class="btn btn-outline" onclick="sendPromptSafe('Open manage employers')">Manage employers</button>
          <button class="btn btn-outline" onclick="sendPromptSafe('Open manage job seekers')">Manage job seekers</button>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2>Recent activity</h2>
      <div class="sub">Latest postings across the platform</div>

      <div class="activity-item">
        <div>
          <div class="title">Dave's Hot Chicken</div>
          <div class="company">Painting Kings</div>
        </div>
        <span class="badge">New job</span>
      </div>
      <div class="activity-item">
        <div>
          <div class="title">Painter</div>
          <div class="company">Painting Kings</div>
        </div>
        <span class="badge">New job</span>
      </div>
    </section>

    <footer>© 2026 · Insider Careers</footer>
  </main>

<script>
  function sendPromptSafe(msg){
    if (typeof sendPrompt === 'function') sendPrompt(msg);
  }

  function updateClock(){
    const now = new Date();
    let h = now.getHours();
    const m = now.getMinutes().toString().padStart(2,'0');
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12; h = h === 0 ? 12 : h;
    document.getElementById('liveTime').innerHTML = h + ':' + m + ' <span id="ampm">' + ampm + '</span>';
    const opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' };
    document.getElementById('liveDate').textContent = now.toLocaleDateString('en-US', opts);

    const hour = now.getHours();
    const greetEl = document.getElementById('greetingText');
    const period = hour < 12 ? 'morning' : (hour < 18 ? 'afternoon' : 'evening');
    greetEl.innerHTML = 'Good ' + period + ', <span style="color:var(--violet-2)">Christopher</span> <span class="wave">👋</span>';
  }
  updateClock();
  setInterval(updateClock, 30000);

  const ctx = document.getElementById('clicksChart');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ["Dave's Hot Chicken", 'Painter'],
      datasets: [{
        label: 'Clicks',
        data: [2, 1],
        backgroundColor: '#7c5cff',
        borderRadius: 6,
        maxBarThickness: 46
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          beginAtZero: true,
          max: 3,
          ticks: { stepSize: 1, color: '#a7add0', font: { size: 11 } },
          grid: { color: 'rgba(255,255,255,0.06)' }
        },
        x: {
          ticks: { color: '#a7add0', font: { size: 11 } },
          grid: { display: false }
        }
      }
    }
  });
</script>

</body>
</html>